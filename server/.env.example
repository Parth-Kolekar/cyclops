# Copy to server/.env and paste your key. .env is git-ignored.
# Key from https://aistudio.google.com/apikey

GEMINI_API_KEY=
# Benchmarked fastest and most reliable of the flash family for this task.
# The bigger flash models were slower and often 503 under load.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_S=20

# auto | stub | llm
#   auto — LLM when a key is set, stub otherwise (default)
#   stub — force the rule-based planner, no network needed
#   llm  — never silently fall back; raise instead
CYCLOPS_PLANNER=auto
