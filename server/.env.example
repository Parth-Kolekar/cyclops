# Copy to server/.env and paste your keys. .env is git-ignored.

# ---- primary provider ----
# Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# ---- fallback provider ----
# Key from https://aistudio.google.com/apikey
# Benchmarked fastest and most reliable of the Gemini flash family for this
# task. The bigger flash models were slower and frequently 503 under load.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

LLM_TIMEOUT_S=20

# Tried left to right; the first one holding a key answers, the rest are the
# safety net. Anything after the last one falls through to the rule stub.
CYCLOPS_PROVIDERS=openrouter,gemini

# auto | stub | llm
#   auto — use whichever providers have keys, else the stub (default)
#   stub — force the rule-based planner, no network needed
#   llm  — never silently fall back to the stub; raise instead
CYCLOPS_PLANNER=auto
