{
  "manifest_version": 3,
  "name": "Cyclops — Private Vision Agent",
  "version": "0.1.0",
  "description": "Screen-aware browser agent that sends the server a sanitized description of your screen, never your data.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' http://localhost:8000 https://huggingface.co https://*.huggingface.co https://*.hf.co blob: data:;"
  },
  "background": {
    "service_worker": "dist/background/sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Cyclops"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/extractor.js",
        "src/content/pii.js",
        "src/content/executor.js",
        "src/content/overlay.js",
        "src/content/index.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/tools/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
